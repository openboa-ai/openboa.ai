{
  "name": "openboa.ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tokens:generate": "node scripts/generate-openboa-tokens.mjs",
    "tokens:check": "node scripts/generate-openboa-tokens.mjs --check",
    "test:design": "pnpm tokens:check && node scripts/check-design-token-contract.mjs",
    "test:responsive": "pnpm test:design && node scripts/check-responsive-css.mjs",
    "test:repository-security": "node --test scripts/check-repository-security.test.mjs && node scripts/check-repository-security.mjs",
    "test:security": "node scripts/check-security-headers.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.3.1",
    "js-yaml": "4.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
